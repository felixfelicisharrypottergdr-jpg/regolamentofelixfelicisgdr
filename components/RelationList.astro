---
type Item = { title: string; url: string };
type Props = { title: string; items: Item[] };
const { title, items } = Astro.props;
---
{items.length > 0 && (
  <section class="felix-relations">
    <h2>{title}</h2>
    <ul>
      {items.map((item) => <li><a href={item.url}>{item.title}</a></li>)}
    </ul>
  </section>
)}
