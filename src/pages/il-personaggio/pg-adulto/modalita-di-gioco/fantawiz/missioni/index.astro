---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';
import FelixCatalog from '../../../../../../components/FelixCatalog.astro';
import FelixBadges from '../../../../../../components/FelixBadges.astro';
import SearchMetadata from '../../../../../../components/search/SearchMetadata.astro';
import { routeForStructured } from '../../../../../../config/routes';

const missions=(await getCollection('adultMissions'))
  .filter((entry)=>entry.data.status==='published')
  .sort((a,b)=>a.data.name.localeCompare(b.data.name,'it'));
---
<StarlightPage frontmatter={{title:'Missioni del FantaWiz',description:'Consulta e filtra tutte le Missioni del FantaWiz per PG Adulti.'}}>
  <SearchMetadata
    type="Catalogo"
    macroarea="Il Personaggio"
    aliases={['fantawiz','missioni adulti','missioni sinistre','missioni neutrali','missioni virtuose']}
    filters={{ applicability:'PG Adulto' }}
  />

  <FelixCatalog searchLabel="Cerca nelle Missioni" searchPlaceholder="Nome, descrizione, requisito o premio..." count={missions.length} countLabel="Missioni">
    <label class="felix-filter-control" slot="filters">
      <span>Categoria</span>
      <select data-filter="category" data-filter-label="Categoria">
        <option value="">Tutte</option>
        <option>Sinistra</option>
        <option>Neutrale</option>
        <option>Virtuosa</option>
      </select>
    </label>
    <label class="felix-filter-toggle" slot="filters">
      <input type="checkbox" data-filter="illegal" data-filter-label="Richiede Narratore" data-active-label="Richiede Narratore" />
      <span>Richiede Narratore</span>
    </label>
    <label class="felix-filter-toggle" slot="filters">
      <input type="checkbox" data-filter="completion" data-filter-label="A completamento" data-active-label="A completamento" />
      <span>A completamento</span>
    </label>

    {missions.map((entry)=>(
      <article
        class="felix-creature-row felix-mission-row"
        data-card
        data-haystack={`${entry.data.name} ${entry.data.description} ${entry.data.searchAliases.join(' ')} ${entry.data.levels.flatMap((level)=>[level.action,...level.requirements,...level.rewards,...level.ifCaught]).join(' ')}`.toLowerCase()}
        data-category={entry.data.category}
        data-illegal={entry.data.illegal ? 'true' : 'false'}
        data-completion={entry.data.completion ? 'true' : 'false'}
      >
        <div>
          <h2><a href={routeForStructured('adultMissions',entry.data.slug)}>{entry.data.name}</a></h2>
          <FelixBadges items={[
            entry.data.category,
            `${entry.data.levels.length} ${entry.data.levels.length===1?'Livello':'Livelli'}`,
            entry.data.illegal ? 'Richiede Narratore' : '',
            entry.data.completion ? 'A completamento' : '',
          ]} />
          <p>{entry.data.description}</p>
        </div>
      </article>
    ))}
  </FelixCatalog>
</StarlightPage>
