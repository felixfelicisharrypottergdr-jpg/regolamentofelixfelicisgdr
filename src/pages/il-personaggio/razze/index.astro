---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';
import FelixBadges from '../../../components/FelixBadges.astro';
import FelixCatalog from '../../../components/FelixCatalog.astro';
import SearchMetadata from '../../../components/search/SearchMetadata.astro';
import { routeForStructured } from '../../../config/routes';

const races = (await getCollection('races'))
  .filter((entry) => entry.data.status === 'published')
  .sort((a, b) => a.data.name.localeCompare(b.data.name, 'it'));
---
<StarlightPage frontmatter={{ title: 'Razze', description: 'Regole sulle Razze ed Elenco delle Razze giocabili.' }}>
  <SearchMetadata type="Elenco" macroarea="Il Personaggio" aliases={['razze', 'razze giocabili', 'pg razziato', 'razziati']} filters={{ applicability: ['PG Studente', 'PG Adulto'] }} />

  <article data-pagefind-body>
    <p class="felix-lead">Le Razze Speciali prevedono Privilegi, Svantaggi e regole proprie. Le peculiarità narrative non sostituiscono né ampliano i Tratti Razziali previsti dalla relativa scheda.</p>

    <section class="felix-reference-strip" aria-label="Regole rapide sulle Razze">
      <div><span>Posti</span><strong>3 per Razza</strong></div>
      <div><span>Per Player</span><strong>max 2 PG razziati</strong></div>
      <div><span>Applicabilità</span><strong>Studenti e Adulti</strong></div>
    </section>

    <h2>Elenco delle Razze</h2>
    <FelixCatalog searchLabel="Cerca nell'Elenco delle Razze" count={races.length} countLabel="Razze">
      {races.map((entry) => (
        <article
          class="felix-creature-row"
          data-card
          data-name={entry.data.name.toLowerCase()}
          data-description={entry.data.description.toLowerCase()}
          data-aliases={entry.data.searchAliases.join(' ').toLowerCase()}
        >
          <div>
            <h3><a href={routeForStructured('races', entry.data.slug)}>{entry.data.name}</a></h3>
            <FelixBadges items={entry.data.applicability.map((item) => item === 'student' ? 'PG Studente' : 'PG Adulto').concat(entry.data.availablePlaces ? [`Posti disponibili: ${entry.data.availablePlaces}`] : [])} />
            <p>{entry.data.description}</p>
          </div>
        </article>
      ))}
    </FelixCatalog>
  </article>
</StarlightPage>
