---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection, render } from 'astro:content';
import FelixEntityHeader from '../../../components/FelixEntityHeader.astro';
import SearchMetadata from '../../../components/search/SearchMetadata.astro';

export async function getStaticPaths() {
  return (await getCollection('races')).filter((entry) => entry.data.status === 'published').map((entry) => ({
    params: { slug: entry.data.slug }, props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const pageHeadings = headings;
---
<StarlightPage frontmatter={{ title: entry.data.name, description: entry.data.description }} headings={pageHeadings}>
  <SearchMetadata type="Razza" macroarea="Il Personaggio" aliases={entry.data.searchAliases} filters={{ applicability: entry.data.applicability.map((item) => item === 'student' ? 'PG Studente' : 'PG Adulto') }} />
  <article class="felix-entry" data-pagefind-body>
    <FelixEntityHeader
      description={entry.data.description}
      image={entry.data.image}
      imageAlt={`Illustrazione: ${entry.data.name}`}
      badges={entry.data.applicability.map((item) => item === 'student' ? 'PG Studente' : 'PG Adulto')}
      facts={[
        { label: 'Posti disponibili', value: entry.data.availablePlaces ?? '—' },
      ]}
    />

    <Content />
  </article>
</StarlightPage>
