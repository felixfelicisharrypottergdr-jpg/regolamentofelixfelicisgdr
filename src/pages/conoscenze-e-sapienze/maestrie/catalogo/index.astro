---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';
import FelixCatalog from '../../../../components/FelixCatalog.astro';
import FelixBadges from '../../../../components/FelixBadges.astro';
import SearchMetadata from '../../../../components/search/SearchMetadata.astro';
import { routeForStructured } from '../../../../config/routes';

const masteries=(await getCollection('masteries'))
  .filter((entry)=>entry.data.status==='published')
  .sort((a,b)=>a.data.name.localeCompare(b.data.name,'it'));
const parameters=[...new Set(masteries.map((entry)=>entry.data.parameter))].sort((a,b)=>a.localeCompare(b,'it'));
---
<StarlightPage frontmatter={{title:'Catalogo delle Maestrie',description:'Consulta le 36 Maestrie e filtrale per Sapienza Magica e Parametro di riferimento.'}}>
  <SearchMetadata type="Catalogo" macroarea="Conoscenze e Sapienze" aliases={['maestrie','catalogo maestrie','specializzazioni sapienze']} />

  <FelixCatalog searchLabel="Cerca una Maestria" searchPlaceholder="Nome, Sapienza, Parametro o effetto..." count={masteries.length} countLabel="Maestrie">
    <label class="felix-filter-control" slot="filters">
      <span>Sapienza</span>
      <select data-filter="wisdom" data-filter-label="Sapienza">
        <option value="">Tutte</option>
        {['Arcaica','Difensiva','Divinatoria','Elementale','Erbologica','Magizoologica','Medimagica','Mentale','Offensiva','Oscura','Pozionistica','Trasfigurativa'].map((value)=><option>{value}</option>)}
      </select>
    </label>
    <label class="felix-filter-control" slot="filters">
      <span>Parametro</span>
      <select data-filter="parameter" data-filter-label="Parametro">
        <option value="">Tutti</option>
        {parameters.map((value)=><option>{value}</option>)}
      </select>
    </label>

    {masteries.map((entry)=>(
      <article
        class="felix-creature-row"
        data-card
        data-haystack={`${entry.data.name} ${entry.data.description} ${entry.data.wisdom} ${entry.data.parameter} ${entry.data.searchAliases.join(' ')}`.toLowerCase()}
        data-wisdom={entry.data.wisdom}
        data-parameter={entry.data.parameter}
      >
        <div>
          <h2><a href={routeForStructured('masteries',entry.data.slug)}>{entry.data.name}</a></h2>
          <FelixBadges items={[entry.data.wisdom,entry.data.parameter]} />
          <p>{entry.data.description}</p>
        </div>
      </article>
    ))}
  </FelixCatalog>
</StarlightPage>
