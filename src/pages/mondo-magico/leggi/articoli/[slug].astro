---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection, render } from 'astro:content';
import FelixEntityHeader from '../../../../components/FelixEntityHeader.astro';
import SearchMetadata from '../../../../components/search/SearchMetadata.astro';
export async function getStaticPaths(){return (await getCollection('legalArticles')).filter(e=>e.data.status==='published').map(entry=>({params:{slug:entry.data.slug},props:{entry}}));}
const {entry}=Astro.props; const {Content,headings}=await render(entry);
---
<StarlightPage frontmatter={{title:`Art. ${entry.data.articleNumber}${entry.data.title?` — ${entry.data.title}`:''}`,description:entry.data.description}} headings={headings}>
  <SearchMetadata type="Articolo" macroarea="Mondo Magico" aliases={entry.data.searchAliases} filters={{ legal_status: entry.data.onGameStatus }} />
  <article class="felix-entry" data-pagefind-body>
    <FelixEntityHeader
      description={entry.data.description}
      imageAlt={`Articolo ${entry.data.articleNumber}`}
      badges={[entry.data.onGameStatus]}
      facts={[
        { label: 'Sezione', value: entry.data.section ?? '—' },
        { label: 'Stato ONGame', value: entry.data.onGameStatus },
        { label: 'In vigore dal', value: entry.data.effectiveDate ?? '—' },
        { label: 'Cessazione', value: entry.data.endDate ?? '—' },
      ]}
    />
    <Content />
  </article>
</StarlightPage>
