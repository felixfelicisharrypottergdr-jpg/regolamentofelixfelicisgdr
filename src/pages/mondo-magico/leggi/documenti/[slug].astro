---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection, render } from 'astro:content';
import FelixEntityHeader from '../../../../components/FelixEntityHeader.astro';
import { buildFelixIndex } from '../../../../lib/content-index';
import SearchMetadata from '../../../../components/search/SearchMetadata.astro';
import { routeForStructured } from '../../../../config/routes';
export async function getStaticPaths(){return (await getCollection('legalDocuments')).filter(e=>e.data.status==='published').map(entry=>({params:{slug:entry.data.slug},props:{entry}}));}
const {entry}=Astro.props; const {Content,headings}=await render(entry); const index=await buildFelixIndex(); const related=entry.data.relatedFelixIds.map(id=>index.get(id)).filter(Boolean);
const articles=(await getCollection('legalArticles')).filter(a=>a.data.status==='published'&&a.data.documentId===entry.id).sort((a,b)=>Number(a.data.articleNumber)-Number(b.data.articleNumber));
---
<StarlightPage frontmatter={{title:entry.data.title,description:entry.data.description}} headings={headings}>
  <SearchMetadata type="Documento normativo" macroarea="Mondo Magico" aliases={entry.data.searchAliases} filters={{ legal_status: entry.data.onGameStatus }} />
  <article class="felix-entry" data-pagefind-body>
    <FelixEntityHeader
      description={entry.data.description}
      imageAlt={entry.data.title}
      badges={[entry.data.onGameStatus]}
      facts={[
        { label: 'Stato ONGame', value: entry.data.onGameStatus },
        { label: 'In vigore dal', value: entry.data.effectiveDate ?? '—' },
        { label: 'Cessazione', value: entry.data.endDate ?? '—' },
      ]}
    />
    <Content />
    <section><h2>Articoli</h2><ul class="felix-related-list">{articles.map(a=><li><a href={routeForStructured('legalArticles',a.data.slug)}>Art. {a.data.articleNumber}{a.data.title?` — ${a.data.title}`:''}</a>{a.data.section?` · ${a.data.section}`:''}</li>)}</ul></section>
  </article>
</StarlightPage>
