---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';
import SearchMetadata from '../../../components/search/SearchMetadata.astro';
import FelixBadges from '../../../components/FelixBadges.astro';
import { routeForStructured } from '../../../config/routes';
const documents=(await getCollection('legalDocuments')).filter(e=>e.data.status==='published');
---
<StarlightPage frontmatter={{ title:'Leggi Magiche', description:'Documenti normativi e Articoli del Mondo Magico.' }}>
  <SearchMetadata type="Area" macroarea="Mondo Magico" aliases={['leggi','diritto magico','norme']} />
  <article class="felix-entry" data-pagefind-body>
    <p class="felix-kicker">Mondo Magico › Leggi Magiche</p>
    <p class="felix-lead">I documenti normativi e i singoli Articoli sono contenuti distinti: questo permette ricerca precisa, collegamenti puntuali e versionamento ONGame senza perdere il testo storico. Il catalogo comprende Carta dei Diritti e dei Doveri, Codice di Diritto Magico e Corollario delle Sanzioni e delle Pene.</p>
    <div class="felix-catalog-list">
      {documents.map(doc => <section class="felix-creature-row"><div><h2><a href={routeForStructured('legalDocuments',doc.data.slug)}>{doc.data.title}</a></h2><FelixBadges items={[doc.data.onGameStatus]} /><p>{doc.data.description}</p></div></section>)}
    </div>
  </article>
</StarlightPage>
