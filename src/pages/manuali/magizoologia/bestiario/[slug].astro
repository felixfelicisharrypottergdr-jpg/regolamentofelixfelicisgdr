---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import AnchorHeading from '@astrojs/starlight/components/AnchorHeading.astro';
import { getCollection, getEntry, render } from 'astro:content';
import FelixBadges from '../../../../components/FelixBadges.astro';
import RelationList from '../../../../components/RelationList.astro';
import SearchMetadata from '../../../../components/search/SearchMetadata.astro';
import { buildFelixIndex } from '../../../../lib/content-index';

export async function getStaticPaths() {
  return (await getCollection('creatures')).filter((entry) => entry.data.status === 'published').map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const index = await buildFelixIndex();
const diseases = entry.data.causesDiseases.map((id) => index.get(id)).filter(Boolean);
const ingredients = entry.data.producesIngredients.map((id) => index.get(id)).filter(Boolean);
const related = entry.data.relatedFelixIds.map((id) => index.get(id)).filter(Boolean);
const badges = [entry.data.classification ?? '', entry.data.category ?? '', entry.data.hostility ?? '', entry.data.exotic ? 'Esotica' : '', entry.data.legality ?? ''];
---
<StarlightPage frontmatter={{ title: entry.data.name, description: entry.data.description }} headings={headings}>
  <SearchMetadata
    type="Creatura"
    macroarea="Manuali"
    aliases={entry.data.searchAliases}
    filters={{
      classification: entry.data.classification,
      hostility: entry.data.hostility,
      exotic: entry.data.exotic,
      category: entry.data.category,
    }}
  />
  <article class="felix-entry" data-pagefind-body>
    <div class="felix-entry-header">
      <div>
        <p class="felix-kicker">Manuali › Magizoologia › Bestiario</p>
        <p class="felix-lead">{entry.data.description}</p>
        <FelixBadges items={badges} />
      </div>
      {entry.data.image && <img class="felix-entry-image" src={entry.data.image} alt={`Illustrazione: ${entry.data.name}`} />}
    </div>


    <Content />

    {entry.data.values && (
      <section>
        <AnchorHeading level="2" id="valori">Valori</AnchorHeading>
        <table class="felix-values">
          <thead><tr><th>Classificazione</th><th>Forza</th><th>Salute</th><th>Resistenza</th><th>Destrezza</th></tr></thead>
          <tbody><tr><td>{entry.data.classification}</td><td>{entry.data.values.force}</td><td>{entry.data.values.health}</td><td>{entry.data.values.resistance}</td><td>{entry.data.values.dexterity}</td></tr></tbody>
        </table>
      </section>
    )}

    <RelationList title="Può causare" items={diseases} />
    <RelationList title="Ingredienti" items={ingredients} />
    <RelationList title="Regole collegate" items={related} />
  </article>
</StarlightPage>
