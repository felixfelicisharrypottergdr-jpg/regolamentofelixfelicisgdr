---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import AnchorHeading from '@astrojs/starlight/components/AnchorHeading.astro';
import { getCollection, getEntry, render } from 'astro:content';
import FelixBadges from '../../../../components/FelixBadges.astro';
import SearchMetadata from '../../../../components/search/SearchMetadata.astro';
import { buildFelixIndex } from '../../../../lib/content-index';

export async function getStaticPaths() {
  return (await getCollection('creatures')).filter((entry) => entry.data.status === 'published').map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const index = await buildFelixIndex();
const diseases = entry.data.causesDiseases.map((id) => index.get(id)).filter(Boolean);
const ingredients = entry.data.producesIngredients.map((id) => index.get(id)).filter(Boolean);
const related = entry.data.relatedFelixIds.map((id) => index.get(id)).filter(Boolean);
const badges = [entry.data.exotic ? 'Esotica' : ''].filter(Boolean);
const facts = [
  ['Categoria', entry.data.category ?? '—'],
  ['Classificazione', entry.data.classification ?? '—'],
  ['Ostilità', entry.data.hostility ?? '—'],
  ['Legalità', entry.data.legality ?? '—'],
];
---
<StarlightPage frontmatter={{ title: entry.data.name, description: entry.data.description }} headings={headings}>
  <SearchMetadata
    type="Creatura"
    macroarea="Manuali"
    aliases={entry.data.searchAliases}
    filters={{
      classification: entry.data.classification,
      hostility: entry.data.hostility,
      exotic: entry.data.exotic,
      category: entry.data.category,
    }}
  />
  <article class="felix-entry" data-pagefind-body>
    <div class="felix-entry-header">
      <div class="felix-entry-copy">
        <p class="felix-lead">{entry.data.description}</p>
        <FelixBadges items={badges} />

        <section class="felix-entry-brief" aria-label="In breve">
          <h2>In breve</h2>
          <dl class="felix-entry-facts">
            {facts.map(([label, value]) => (
              <div>
                <dt>{label}</dt>
                <dd>{value}</dd>
              </div>
            ))}
          </dl>
        </section>
      </div>
      {entry.data.image && (
        <figure class="felix-entry-visual">
          <img class="felix-entry-image" src={entry.data.image} alt={`Illustrazione: ${entry.data.name}`} />
        </figure>
      )}
    </div>


    <Content />

    {entry.data.values && (
      <section class="felix-values-section">
        <AnchorHeading level="2" id="valori">Valori</AnchorHeading>
        <div class="felix-stats-grid" role="list" aria-label="Valori della Creatura">
          <div class="felix-stat" role="listitem"><span>Classificazione</span><strong>{entry.data.classification}</strong></div>
          <div class="felix-stat" role="listitem"><span>Forza</span><strong>{entry.data.values.force}</strong></div>
          <div class="felix-stat" role="listitem"><span>Salute</span><strong>{entry.data.values.health}</strong></div>
          <div class="felix-stat" role="listitem"><span>Resistenza</span><strong>{entry.data.values.resistance}</strong></div>
          <div class="felix-stat" role="listitem"><span>Destrezza</span><strong>{entry.data.values.dexterity}</strong></div>
        </div>
      </section>
    )}
  </article>
</StarlightPage>
