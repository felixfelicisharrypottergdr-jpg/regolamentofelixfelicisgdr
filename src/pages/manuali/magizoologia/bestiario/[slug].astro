---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import AnchorHeading from '@astrojs/starlight/components/AnchorHeading.astro';
import { getCollection, getEntry, render } from 'astro:content';
import FelixEntityHeader from '../../../../components/FelixEntityHeader.astro';
import FelixStatsGrid from '../../../../components/FelixStatsGrid.astro';
import SearchMetadata from '../../../../components/search/SearchMetadata.astro';
import { buildFelixIndex } from '../../../../lib/content-index';

export async function getStaticPaths() {
  return (await getCollection('creatures')).filter((entry) => entry.data.status === 'published').map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const index = await buildFelixIndex();
const diseases = entry.data.causesDiseases.map((id) => index.get(id)).filter(Boolean);
const ingredients = entry.data.producesIngredients.map((id) => index.get(id)).filter(Boolean);
const related = entry.data.relatedFelixIds.map((id) => index.get(id)).filter(Boolean);
const badges = [entry.data.exotic ? 'Esotica' : ''].filter(Boolean);
const facts = [
  { label: 'Categoria', value: entry.data.category ?? '—' },
  { label: 'Classificazione', value: entry.data.classification ?? '—' },
  { label: 'Ostilità', value: entry.data.hostility ?? '—' },
  { label: 'Legalità', value: entry.data.legality ?? '—' },
];
---
<StarlightPage frontmatter={{ title: entry.data.name, description: entry.data.description }} headings={headings}>
  <SearchMetadata
    type="Creatura"
    macroarea="Manuali"
    aliases={entry.data.searchAliases}
    filters={{
      classification: entry.data.classification,
      hostility: entry.data.hostility,
      exotic: entry.data.exotic,
      category: entry.data.category,
    }}
  />
  <article class="felix-entry" data-pagefind-body>
    <FelixEntityHeader
      description={entry.data.description}
      image={entry.data.image}
      imageAlt={`Illustrazione: ${entry.data.name}`}
      badges={badges}
      facts={facts}
    />

    <Content />

    {entry.data.values && (
      <section class="felix-values-section">
        <AnchorHeading level="2" id="valori">Valori</AnchorHeading>
        <FelixStatsGrid
          ariaLabel="Valori della Creatura"
          items={[
            { label: 'Classificazione', value: entry.data.classification },
            { label: 'Forza', value: entry.data.values.force },
            { label: 'Salute', value: entry.data.values.health },
            { label: 'Resistenza', value: entry.data.values.resistance },
            { label: 'Destrezza', value: entry.data.values.dexterity },
          ]}
        />
      </section>
    )}
  </article>
</StarlightPage>
