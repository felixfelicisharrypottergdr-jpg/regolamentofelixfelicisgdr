---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection, render } from 'astro:content';
import { buildBacklinkIndex } from '../../../lib/backlinks';
import { buildFelixIndex } from '../../../lib/content-index';
import RelationList from '../../../components/RelationList.astro';
import FelixBadges from '../../../components/FelixBadges.astro';
import SearchMetadata from '../../../components/search/SearchMetadata.astro';

export async function getStaticPaths() {
  return (await getCollection('ingredients')).filter((entry) => entry.data.status === 'published').map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const backlinks = await buildBacklinkIndex();
const index = await buildFelixIndex();
const entryBacklinks = backlinks.get(entry.id) ?? [];
const sources = entryBacklinks
  .filter((item) => item.relation === 'producesIngredient')
  .map((item) => index.get(item.sourceId))
  .filter(Boolean);
const usedInPotions = entryBacklinks
  .filter((item) => item.relation === 'usesIngredient')
  .map((item) => index.get(item.sourceId))
  .filter(Boolean);
---
<StarlightPage frontmatter={{ title: entry.data.name, description: entry.data.description || entry.data.provenance }} headings={headings}>
  <SearchMetadata
    type="Ingrediente"
    macroarea="Manuali"
    aliases={entry.data.searchAliases}
    filters={{ classification: entry.data.classification, exotic: entry.data.exotic }}
  />
  <article class="felix-entry" data-pagefind-body>
    <p class="felix-kicker">Manuali › Ingredienti</p>
    <FelixBadges items={[entry.data.classification, entry.data.goodsClass, entry.data.legality, entry.data.exotic ? 'Esotico' : '']} />
    <dl class="felix-definition-list">
      <dt>Provenienza</dt><dd>{entry.data.provenance}</dd>
      <dt>Effetto</dt><dd>{entry.data.effect}</dd>
    </dl>
    <Content />
    <RelationList title="Ottenibile da" items={sources} />
    <RelationList title="Utilizzato in" items={usedInPotions} />
  </article>
</StarlightPage>
