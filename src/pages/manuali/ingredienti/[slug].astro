---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection, render } from 'astro:content';
import FelixEntityHeader from '../../../components/FelixEntityHeader.astro';
import SearchMetadata from '../../../components/search/SearchMetadata.astro';

export async function getStaticPaths() {
  return (await getCollection('ingredients')).filter((entry) => entry.data.status === 'published').map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---
<StarlightPage frontmatter={{ title: entry.data.name, description: entry.data.description || entry.data.provenance }} headings={headings}>
  <SearchMetadata
    type="Ingrediente"
    macroarea="Manuali"
    aliases={entry.data.searchAliases}
    filters={{ classification: entry.data.classification, exotic: entry.data.exotic }}
  />
  <article class="felix-entry" data-pagefind-body>
    <FelixEntityHeader
      description={entry.data.description || entry.data.provenance}
      imageAlt={`Ingrediente: ${entry.data.name}`}
      badges={[entry.data.exotic ? 'Esotico' : '']}
      facts={[
        { label: 'Classificazione', value: entry.data.classification },
        { label: 'Classe merce', value: entry.data.goodsClass },
        { label: 'Legalità', value: entry.data.legality },
        { label: 'Provenienza', value: entry.data.provenance },
      ]}
    />
    {entry.data.effect && <p class="felix-entry-effect"><strong>Effetto:</strong> {entry.data.effect}</p>}
    <Content />
  </article>
</StarlightPage>
