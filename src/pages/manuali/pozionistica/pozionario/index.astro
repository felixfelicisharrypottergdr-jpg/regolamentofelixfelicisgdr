---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';
import FelixBadges from '../../../../components/FelixBadges.astro';
import SearchMetadata from '../../../../components/search/SearchMetadata.astro';
import { routeForStructured } from '../../../../config/routes';

const potions = (await getCollection('potions'))
  .filter((entry) => entry.data.status === 'published')
  .sort((a, b) => a.data.name.localeCompare(b.data.name, 'it'));
---
<StarlightPage frontmatter={{ title: 'Pozionario', description: 'Consulta le Pozioni del prototipo FELIX FELICIS.' }}>
  <SearchMetadata type="Catalogo" macroarea="Manuali" aliases={['pozioni', 'pozionistica', 'pozionario']} />

  <div class="felix-catalog" data-catalog="potions">
    <aside class="felix-filters" aria-label="Filtri Pozionario">
      <h2>Filtri</h2>
      <label>
        Classificazione
        <select data-filter="classification">
          <option value="">Tutte</option>
          <option>X</option><option>XX</option><option>XXX</option><option>XXXX</option><option>XXXXX</option>
        </select>
      </label>
      <label>
        Tipologia
        <select data-filter="type">
          <option value="">Tutte</option>
          {[...new Set(potions.map((entry) => entry.data.type))].sort().map((type) => <option>{type}</option>)}
        </select>
      </label>
      <button type="button" data-reset>Azzera filtri</button>
    </aside>

    <section>
      <div class="felix-catalog-toolbar">
        <label>Cerca nel Pozionario <input type="search" data-filter="query" placeholder="Nome, descrizione o alias..." /></label>
        <strong><span data-count>{potions.length}</span> Pozioni</strong>
      </div>
      <div class="felix-active-filters" data-active-filters hidden></div>
      <div class="felix-filter-actions">
        <button type="button" data-copy-filter-link>Copia link ai filtri</button>
        <span data-copy-status role="status" aria-live="polite"></span>
      </div>
      <div class="felix-catalog-list" data-pagefind-ignore>
        {potions.map((entry) => (
          <article class="felix-creature-row" data-card
            data-name={entry.data.name.toLowerCase()}
            data-description={entry.data.description.toLowerCase()}
            data-aliases={entry.data.searchAliases.join(' ').toLowerCase()}
            data-classification={entry.data.classification}
            data-type={entry.data.type}>
            <h2><a href={routeForStructured('potions', entry.data.slug)}>{entry.data.name}</a></h2>
            <FelixBadges items={[entry.data.classification, entry.data.type, entry.data.administration ?? '']} />
            <p>{entry.data.description}</p>
          </article>
        ))}
      </div>
    </section>
  </div>

  <script>
    const root = document.querySelector('[data-catalog="potions"]');
    if (root) {
      const cards = [...root.querySelectorAll('[data-card]')];
      const fields = Object.fromEntries([...root.querySelectorAll('[data-filter]')].map((el) => [el.dataset.filter, el]));
      const count = root.querySelector('[data-count]');
      const activeFilters = root.querySelector('[data-active-filters]');
      const copyStatus = root.querySelector('[data-copy-status]');
      const params = new URLSearchParams(window.location.search);
      if (fields.query) fields.query.value = params.get('q') || '';
      if (fields.classification) fields.classification.value = params.get('classification') || '';
      if (fields.type) fields.type.value = params.get('type') || '';

      const state = () => ({ query: (fields.query?.value || '').trim(), classification: fields.classification?.value || '', type: fields.type?.value || '' });
      const sync = (s) => { const p = new URLSearchParams(); if (s.query) p.set('q', s.query); if (s.classification) p.set('classification', s.classification); if (s.type) p.set('type', s.type); history.replaceState(null, '', `${location.pathname}${p.toString() ? `?${p}` : ''}`); };
      const renderActive = (s) => { const labels=[]; if(s.query)labels.push(`Ricerca: ${s.query}`); if(s.classification)labels.push(`Classificazione: ${s.classification}`); if(s.type)labels.push(`Tipologia: ${s.type}`); activeFilters.replaceChildren(...labels.map((label)=>{const x=document.createElement('span');x.className='felix-filter-chip';x.textContent=label;return x;})); activeFilters.hidden=labels.length===0; };
      const apply = (update=true) => { const s=state(); const q=s.query.toLowerCase(); let visible=0; cards.forEach((card)=>{ const hay=`${card.dataset.name||''} ${card.dataset.description||''} ${card.dataset.aliases||''}`; const show=(!q||hay.includes(q))&&(!s.classification||card.dataset.classification===s.classification)&&(!s.type||card.dataset.type===s.type); card.hidden=!show; if(show)visible++; }); count.textContent=String(visible); renderActive(s); if(update)sync(s); };
      Object.values(fields).forEach((el)=>el.addEventListener('input',()=>apply(true)));
      root.querySelector('[data-reset]')?.addEventListener('click',()=>{ if(fields.query)fields.query.value=''; if(fields.classification)fields.classification.value=''; if(fields.type)fields.type.value=''; apply(true); });
      root.querySelector('[data-copy-filter-link]')?.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(location.href); copyStatus.textContent='Link copiato.'; setTimeout(()=>copyStatus.textContent='',1800);}catch{copyStatus.textContent='Copia non disponibile: usa la barra del browser.';}});
      apply(false);
    }
  </script>
</StarlightPage>
