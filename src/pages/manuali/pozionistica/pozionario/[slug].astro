---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import AnchorHeading from '@astrojs/starlight/components/AnchorHeading.astro';
import { getCollection, render } from 'astro:content';
import FelixEntityHeader from '../../../../components/FelixEntityHeader.astro';
import FelixDataTable from '../../../../components/FelixDataTable.astro';
import SearchMetadata from '../../../../components/search/SearchMetadata.astro';
import { buildFelixIndex } from '../../../../lib/content-index';

export async function getStaticPaths() {
  return (await getCollection('potions')).filter((entry) => entry.data.status === 'published').map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const index = await buildFelixIndex();
const ingredientRows = entry.data.ingredients.map((item) => ({
  ...item,
  linked: item.ingredientId ? index.get(item.ingredientId) : undefined,
}));
const ingredientTableRows = ingredientRows.map((item) => ({
  ingredient: item.linked ? { text: item.name, href: item.linked.url } : { text: item.name, muted: true },
  amount: item.amount ?? '—',
  classification: item.classification ?? '—',
}));
const pageHeadings = [...headings, { depth: 2, slug: 'ingredienti-e-dosi-tabella', text: 'Ingredienti e dosi — tabella' }];
---
<StarlightPage frontmatter={{ title: entry.data.name, description: entry.data.description }} headings={pageHeadings}>
  <SearchMetadata
    type="Pozione"
    macroarea="Manuali"
    aliases={entry.data.searchAliases}
    filters={{ classification: entry.data.classification, potion_type: entry.data.type, administration: entry.data.administration }}
  />
  <article class="felix-entry" data-pagefind-body>
    <FelixEntityHeader
      description={entry.data.description}
      image={entry.data.image}
      imageAlt={`Illustrazione: ${entry.data.name}`}
      badges={[entry.data.knowledgeGrade ?? '', entry.data.schoolYear ? `Anno ${entry.data.schoolYear}` : '']}
      facts={[
        { label: 'Classificazione', value: entry.data.classification },
        { label: 'Tipologia', value: entry.data.type },
        { label: 'Somministrazione', value: entry.data.administration ?? '—' },
        { label: 'Legalità', value: entry.data.legality ?? '—' },
        { label: 'Forza standard', value: entry.data.standardStrength ?? '—' },
      ]}
    />

    <Content />

    <section>
      <AnchorHeading level="2" id="ingredienti-e-dosi-tabella">Ingredienti e dosi — tabella</AnchorHeading>
      <FelixDataTable
        ariaLabel="Ingredienti e dosi"
        columns={[
          { key: 'ingredient', label: 'Ingrediente' },
          { key: 'amount', label: 'Dosi' },
          { key: 'classification', label: 'Classificazione' },
        ]}
        rows={ingredientTableRows}
      />
      {ingredientRows.some((item) => !item.linked) && (
        <p class="felix-note-small">Le voci non ancora collegate restano comunque leggibili nella ricetta.</p>
      )}
    </section>
  </article>
</StarlightPage>
