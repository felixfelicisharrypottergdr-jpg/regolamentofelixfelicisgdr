---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import AnchorHeading from '@astrojs/starlight/components/AnchorHeading.astro';
import { getCollection, render } from 'astro:content';
import FelixEntityHeader from '../../../../components/FelixEntityHeader.astro';
import FelixDataTable from '../../../../components/FelixDataTable.astro';
import SearchMetadata from '../../../../components/search/SearchMetadata.astro';

export async function getStaticPaths(){
  return (await getCollection('divinationTechniques'))
    .filter((entry)=>entry.data.status==='published')
    .map((entry)=>({params:{slug:entry.data.slug},props:{entry}}));
}

const {entry}=Astro.props;
const {Content,headings}=await render(entry);
const pageHeadings=entry.data.values.length?[...headings,{depth:2,slug:'valori',text:'Valori'}]:headings;
---
<StarlightPage frontmatter={{title:entry.data.name,description:entry.data.description}} headings={pageHeadings}>
  <SearchMetadata
    type="Tecnica Divinatoria"
    macroarea="Manuali"
    aliases={entry.data.searchAliases}
    filters={{
      divination_kind:entry.data.kind,
      divination_year:entry.data.schoolYear,
    }}
  />

  <article class="felix-entry" data-pagefind-body>
    <FelixEntityHeader
      description={entry.data.description}
      image={entry.data.image}
      imageAlt={`Tecnica Divinatoria: ${entry.data.name}`}
      badges={[
        'Divinazione',
        entry.data.kind,
        entry.data.schoolYear ? `Anno ${entry.data.schoolYear}` : '',
      ]}
      facts={[
        {label:'Tipo',value:entry.data.kind},
        {label:'Anno scolastico',value:entry.data.schoolYear ? entry.data.schoolYear : '—'},
        ...entry.data.values.slice(0,3).map((item)=>({label:item.label,value:item.value})),
      ]}
    />

    <Content />

    {entry.data.values.length>0 && (
      <section>
        <AnchorHeading level="2" id="valori">Valori</AnchorHeading>
        <FelixDataTable
          ariaLabel="Valori della Tecnica Divinatoria"
          columns={[
            { key: 'label', label: 'Voce' },
            { key: 'value', label: 'Valore' },
          ]}
          rows={entry.data.values}
        />
      </section>
    )}
  </article>
</StarlightPage>
