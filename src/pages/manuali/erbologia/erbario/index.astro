---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';
import FelixBadges from '../../../../components/FelixBadges.astro';
import FelixCatalog from '../../../../components/FelixCatalog.astro';
import SearchMetadata from '../../../../components/search/SearchMetadata.astro';
import { routeForStructured } from '../../../../config/routes';

const plants = (await getCollection('plants'))
  .filter((entry) => entry.data.status === 'published')
  .sort((a,b) => a.data.name.localeCompare(b.data.name, 'it'));
---
<StarlightPage frontmatter={{ title: 'Erbario', description: 'Consulta e filtra le Piante Magiche.' }}>
  <SearchMetadata type="Catalogo" macroarea="Manuali" aliases={['piante', 'erbologia', 'erbario']} />

  <FelixCatalog searchLabel="Cerca nell'Erbario" count={plants.length} countLabel="Piante">
    <label class="felix-filter-control" slot="filters">
      <span>Classificazione</span>
      <select data-filter="classification" data-filter-label="Classificazione">
        <option value="">Tutte</option>
        <option>X</option><option>XX</option><option>XXX</option><option>XXXX</option><option>XXXXX</option>
      </select>
    </label>
    <label class="felix-filter-control" slot="filters">
      <span>Ostilità</span>
      <select data-filter="hostility" data-filter-label="Ostilità">
        <option value="">Tutte</option>
        <option>Mai ostile</option><option>Neutrale</option><option>Sempre ostile</option>
      </select>
    </label>
    <label class="felix-filter-control" slot="filters">
      <span>Grado di Conoscenza</span>
      <select data-filter="knowledgeGrade" data-param="grade" data-filter-label="Conoscenza">
        <option value="">Tutti</option>
        <option>Scolastica</option><option>Extra</option>
      </select>
    </label>
    <label class="felix-filter-control" slot="filters">
      <span>Anno scolastico</span>
      <select data-filter="schoolYear" data-param="year" data-filter-label="Anno">
        <option value="">Tutti</option>
        <option>V</option><option>VI</option><option>VII</option>
      </select>
    </label>
    <label class="felix-filter-toggle" slot="filters">
      <input type="checkbox" data-filter="exotic" data-filter-label="Esotica" data-active-label="Solo esotiche" />
      <span>Solo esotiche</span>
    </label>

    {plants.map((entry) => (
      <article
        class="felix-creature-row"
        data-card
        data-name={entry.data.name.toLowerCase()}
        data-description={entry.data.description.toLowerCase()}
        data-aliases={entry.data.searchAliases.join(' ').toLowerCase()}
        data-classification={entry.data.classification ?? ''}
        data-hostility={entry.data.hostility ?? ''}
        data-knowledge-grade={entry.data.knowledgeGrade ?? ''}
        data-school-year={entry.data.schoolYear ?? ''}
        data-exotic={entry.data.exotic ? 'true' : 'false'}
      >
        <div>
          <h2><a href={routeForStructured('plants', entry.data.slug)}>{entry.data.name}</a></h2>
          <FelixBadges items={[entry.data.classification ?? '', entry.data.hostility ?? '', entry.data.knowledgeGrade ?? '', entry.data.schoolYear ? `Anno ${entry.data.schoolYear}` : '', entry.data.exotic ? 'Esotica' : '']} />
          <p>{entry.data.description}</p>
        </div>
      </article>
    ))}
  </FelixCatalog>
</StarlightPage>
