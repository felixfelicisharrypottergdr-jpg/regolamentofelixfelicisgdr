---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import AnchorHeading from '@astrojs/starlight/components/AnchorHeading.astro';
import { getCollection, render } from 'astro:content';
import FelixBadges from '../../../../components/FelixBadges.astro';
import SearchMetadata from '../../../../components/search/SearchMetadata.astro';
import { buildFelixIndex } from '../../../../lib/content-index';

export async function getStaticPaths() {
  return (await getCollection('plants')).filter((entry) => entry.data.status === 'published').map((entry) => ({
    params: { slug: entry.data.slug }, props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const index = await buildFelixIndex();
const ingredients = entry.data.producedIngredients.map((item) => ({ ...item, linked: item.ingredientId ? index.get(item.ingredientId) : undefined }));
const related = entry.data.relatedFelixIds.map((id) => index.get(id)).filter(Boolean);
const pageHeadings = [...headings, { depth: 2, slug: 'ingredienti', text: 'Ingredienti' }, { depth: 2, slug: 'valori', text: 'Valori' }];
---
<StarlightPage frontmatter={{ title: entry.data.name, description: entry.data.description }} headings={pageHeadings}>
  <SearchMetadata
    type="Pianta"
    macroarea="Manuali"
    aliases={entry.data.searchAliases}
    filters={{ classification: entry.data.classification, hostility: entry.data.hostility, knowledge_grade: entry.data.knowledgeGrade, school_year: entry.data.schoolYear, exotic: entry.data.exotic }}
  />
  <article class="felix-entry" data-pagefind-body>
    <div class="felix-entry-header">
      <div>
        <p class="felix-lead">{entry.data.description}</p>
        <FelixBadges items={[entry.data.classification ?? '', entry.data.hostility ?? '', entry.data.knowledgeGrade ?? '', entry.data.schoolYear ? `Anno ${entry.data.schoolYear}` : '', entry.data.exotic ? 'Esotica' : '', entry.data.legality ?? '']} />
      </div>
      {entry.data.image && <img class="felix-entry-image" src={entry.data.image} alt={`Illustrazione: ${entry.data.name}`} />}
    </div>

    <Content />

    <section>
      <AnchorHeading level="2" id="ingredienti">Ingredienti</AnchorHeading>
      {ingredients.length ? (
        <ul class="felix-related-list">
          {ingredients.map((item) => <li>{item.linked ? <a href={item.linked.url}>{item.name}</a> : item.name}</li>)}
        </ul>
      ) : <p>Nessun Ingrediente indicato nella scheda.</p>}
      {ingredients.some((item) => !item.linked) && <p class="felix-note-small">Le voci senza collegamento sono conservate integralmente ma non sono ancora state migrate come schede Ingredienti nel prototipo.</p>}
    </section>

    <section>
      <AnchorHeading level="2" id="valori">Valori</AnchorHeading>
      <table class="felix-values"><thead><tr><th>Classificazione</th><th>Forza</th><th>Salute</th><th>Resistenza</th><th>Destrezza</th></tr></thead>
        <tbody><tr><td>{entry.data.classification ?? '—'}</td><td>{entry.data.values?.force ?? '//'}</td><td>{entry.data.values?.health ?? '//'}</td><td>{entry.data.values?.resistance ?? '//'}</td><td>{entry.data.values?.dexterity ?? '//'}</td></tr></tbody>
      </table>
    </section>
  </article>
</StarlightPage>
