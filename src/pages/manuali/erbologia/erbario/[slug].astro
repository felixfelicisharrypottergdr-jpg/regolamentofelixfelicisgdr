---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import AnchorHeading from '@astrojs/starlight/components/AnchorHeading.astro';
import { getCollection, render } from 'astro:content';
import FelixEntityHeader from '../../../../components/FelixEntityHeader.astro';
import FelixStatsGrid from '../../../../components/FelixStatsGrid.astro';
import SearchMetadata from '../../../../components/search/SearchMetadata.astro';
import { buildFelixIndex } from '../../../../lib/content-index';

export async function getStaticPaths() {
  return (await getCollection('plants')).filter((entry) => entry.data.status === 'published').map((entry) => ({
    params: { slug: entry.data.slug }, props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const index = await buildFelixIndex();
const ingredients = entry.data.producedIngredients.map((item) => ({ ...item, linked: item.ingredientId ? index.get(item.ingredientId) : undefined }));
const related = entry.data.relatedFelixIds.map((id) => index.get(id)).filter(Boolean);
const unlinkedIngredients = ingredients.filter((item) => !item.linked);
const pageHeadings = [...headings, ...(unlinkedIngredients.length ? [{ depth: 2, slug: 'ingredienti-non-collegati', text: 'Ingredienti non collegati' }] : []), { depth: 2, slug: 'valori', text: 'Valori' }];
---
<StarlightPage frontmatter={{ title: entry.data.name, description: entry.data.description }} headings={pageHeadings}>
  <SearchMetadata
    type="Pianta"
    macroarea="Manuali"
    aliases={entry.data.searchAliases}
    filters={{ classification: entry.data.classification, hostility: entry.data.hostility, knowledge_grade: entry.data.knowledgeGrade, school_year: entry.data.schoolYear, exotic: entry.data.exotic }}
  />
  <article class="felix-entry" data-pagefind-body>
    <FelixEntityHeader
      description={entry.data.description}
      image={entry.data.image}
      imageAlt={`Illustrazione: ${entry.data.name}`}
      badges={[entry.data.exotic ? 'Esotica' : '']}
      facts={[
        { label: 'Classificazione', value: entry.data.classification ?? '—' },
        { label: 'Ostilità', value: entry.data.hostility ?? '—' },
        { label: 'Conoscenza', value: entry.data.knowledgeGrade ?? '—' },
        { label: 'Anno', value: entry.data.schoolYear ?? '—' },
        { label: 'Legalità', value: entry.data.legality ?? '—' },
      ]}
    />

    <Content />
    {unlinkedIngredients.length > 0 && (
      <section>
        <AnchorHeading level="2" id="ingredienti-non-collegati">Ingredienti non collegati</AnchorHeading>
        <ul class="felix-related-list">{unlinkedIngredients.map((item) => <li>{item.name}</li>)}</ul>
        <p class="felix-note-small">Queste voci sono conservate nella scheda ma non sono ancora state migrate come Ingredienti strutturati.</p>
      </section>
    )}

    <section>
      <AnchorHeading level="2" id="valori">Valori</AnchorHeading>
      <FelixStatsGrid
        ariaLabel="Valori della Pianta"
        items={[
          { label: 'Classificazione', value: entry.data.classification ?? '—' },
          { label: 'Forza', value: entry.data.values?.force ?? '//' },
          { label: 'Salute', value: entry.data.values?.health ?? '//' },
          { label: 'Resistenza', value: entry.data.values?.resistance ?? '//' },
          { label: 'Destrezza', value: entry.data.values?.dexterity ?? '//' },
        ]}
      />
    </section>
  </article>
</StarlightPage>
