---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';
import FelixBadges from '../../../components/FelixBadges.astro';
import SearchMetadata from '../../../components/search/SearchMetadata.astro';
import { routeForStructured } from '../../../config/routes';

const spells = (await getCollection('spells'))
  .filter((entry) => entry.data.status === 'published')
  .sort((a, b) => a.data.name.localeCompare(b.data.name, 'it'));

const families = [...new Set(spells.map((entry) => entry.data.family))].sort((a, b) => a.localeCompare(b, 'it'));
const types = [...new Set(spells.map((entry) => entry.data.type))].sort((a, b) => a.localeCompare(b, 'it'));
const parameters = [...new Set(spells.map((entry) => entry.data.parameter))].sort((a, b) => a.localeCompare(b, 'it'));
const grades = [...new Set(spells.map((entry) => entry.data.knowledgeGrade).filter(Boolean))].sort((a, b) => String(a).localeCompare(String(b), 'it'));
---
<StarlightPage frontmatter={{ title: 'Manuale degli Incantesimi', description: 'Consulta e filtra gli Incantesimi di FELIX FELICIS.' }}>
  <SearchMetadata type="Catalogo" macroarea="Manuali" aliases={['incantesimi', 'manuale incantesimi', 'magie']} />

  <p class="felix-lead">Il prototipo usa un piccolo campione reale per verificare una struttura capace di conservare Valori, Specifiche ed eccezioni senza appiattire Incantesimi molto diversi tra loro.</p>

  <div class="felix-catalog" data-catalog="spells">
    <aside class="felix-filters" aria-label="Filtri Manuale degli Incantesimi">
      <h2>Filtri</h2>
      <label>Famiglia
        <select data-filter="family"><option value="">Tutte</option>{families.map((value) => <option>{value}</option>)}</select>
      </label>
      <label>Tipo
        <select data-filter="type"><option value="">Tutti</option>{types.map((value) => <option>{value}</option>)}</select>
      </label>
      <label>Parametro
        <select data-filter="parameter"><option value="">Tutti</option>{parameters.map((value) => <option>{value}</option>)}</select>
      </label>
      <label>Grado di Conoscenza
        <select data-filter="grade"><option value="">Tutti</option>{grades.map((value) => <option>{value}</option>)}</select>
      </label>
      <label>Anno scolastico
        <select data-filter="year"><option value="">Tutti</option><option>V</option><option>VI</option><option>VII</option></select>
      </label>
      <button type="button" data-reset>Azzera filtri</button>
    </aside>

    <section>
      <div class="felix-catalog-toolbar">
        <label>Cerca nel Manuale <input type="search" data-filter="query" placeholder="Nome, descrizione o alias..." /></label>
        <strong><span data-count>{spells.length}</span> Incantesimi</strong>
      </div>
      <div class="felix-active-filters" data-active-filters hidden></div>
      <div class="felix-filter-actions">
        <button type="button" data-copy-filter-link>Copia link ai filtri</button>
        <span data-copy-status role="status" aria-live="polite"></span>
      </div>

      <div class="felix-catalog-list" data-pagefind-ignore>
        {spells.map((entry) => (
          <article
            class="felix-creature-row"
            data-card
            data-name={entry.data.name.toLowerCase()}
            data-description={entry.data.description.toLowerCase()}
            data-aliases={entry.data.searchAliases.join(' ').toLowerCase()}
            data-family={entry.data.family}
            data-type={entry.data.type}
            data-parameter={entry.data.parameter}
            data-grade={entry.data.knowledgeGrade ?? ''}
            data-year={entry.data.schoolYear ?? ''}
          >
            <div>
              <h2><a href={routeForStructured('spells', entry.data.slug)}>{entry.data.name}</a></h2>
              <FelixBadges items={[entry.data.family, entry.data.knowledgeGrade ?? '', entry.data.schoolYear ? `${entry.data.schoolYear} Anno` : '', entry.data.type]} />
              <p>{entry.data.description}</p>
              <p class="felix-note-small"><strong>Parametro:</strong> {entry.data.parameter} · <strong>Forza:</strong> {entry.data.force ?? '—'} · <strong>Fatica:</strong> {entry.data.fatigue ?? '—'}</p>
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>

  <script>
    const root = document.querySelector('[data-catalog="spells"]');
    if (root) {
      const cards = [...root.querySelectorAll('[data-card]')];
      const fields = Object.fromEntries([...root.querySelectorAll('[data-filter]')].map((el) => [el.dataset.filter, el]));
      const count = root.querySelector('[data-count]');
      const activeFilters = root.querySelector('[data-active-filters]');
      const copyStatus = root.querySelector('[data-copy-status]');
      const params = new URLSearchParams(window.location.search);
      const paramKeys = { query: 'q', family: 'family', type: 'type', parameter: 'parameter', grade: 'grade', year: 'year' };
      Object.entries(fields).forEach(([key, el]) => { el.value = params.get(paramKeys[key] || key) || ''; });

      const state = () => Object.fromEntries(Object.entries(fields).map(([key, el]) => [key, (el.value || '').trim()]));
      const syncUrl = (current) => {
        const next = new URLSearchParams();
        Object.entries(current).forEach(([key, value]) => { if (value) next.set(paramKeys[key] || key, value); });
        history.replaceState(null, '', `${location.pathname}${next.toString() ? `?${next}` : ''}`);
      };
      const renderActive = (current) => {
        const labels = Object.entries(current).filter(([, value]) => value).map(([key, value]) => `${key === 'query' ? 'Ricerca' : key}: ${value}`);
        activeFilters?.replaceChildren(...labels.map((label) => {
          const span = document.createElement('span'); span.className = 'felix-filter-chip'; span.textContent = label; return span;
        }));
        if (activeFilters) activeFilters.hidden = labels.length === 0;
      };
      const apply = (updateUrl = true) => {
        const current = state();
        const query = (current.query || '').toLowerCase();
        let visible = 0;
        cards.forEach((card) => {
          const haystack = `${card.dataset.name || ''} ${card.dataset.description || ''} ${card.dataset.aliases || ''}`;
          const show = (!query || haystack.includes(query))
            && (!current.family || card.dataset.family === current.family)
            && (!current.type || card.dataset.type === current.type)
            && (!current.parameter || card.dataset.parameter === current.parameter)
            && (!current.grade || card.dataset.grade === current.grade)
            && (!current.year || card.dataset.year === current.year);
          card.hidden = !show; if (show) visible += 1;
        });
        if (count) count.textContent = String(visible);
        renderActive(current);
        if (updateUrl) syncUrl(current);
      };
      Object.values(fields).forEach((el) => el.addEventListener('input', () => apply(true)));
      root.querySelector('[data-reset]')?.addEventListener('click', () => { Object.values(fields).forEach((el) => { el.value = ''; }); apply(true); });
      root.querySelector('[data-copy-filter-link]')?.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(window.location.href); if (copyStatus) copyStatus.textContent = 'Link copiato.'; }
        catch { if (copyStatus) copyStatus.textContent = 'Copia non disponibile: usa la barra del browser.'; }
      });
      apply(false);
    }
  </script>
</StarlightPage>
