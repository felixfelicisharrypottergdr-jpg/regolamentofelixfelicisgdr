---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';
import FelixBadges from '../../../components/FelixBadges.astro';
import FelixCatalog from '../../../components/FelixCatalog.astro';
import SearchMetadata from '../../../components/search/SearchMetadata.astro';
import { routeForStructured } from '../../../config/routes';

const spells = (await getCollection('spells'))
  .filter((entry) => entry.data.status === 'published')
  .sort((a, b) => a.data.name.localeCompare(b.data.name, 'it'));

const families = [...new Set(spells.map((entry) => entry.data.family))].sort((a,b) => a.localeCompare(b,'it'));
const types = [...new Set(spells.map((entry) => entry.data.type))].sort((a,b) => a.localeCompare(b,'it'));
const parameters = [...new Set(spells.map((entry) => entry.data.parameter))].sort((a,b) => a.localeCompare(b,'it'));
const grades = [...new Set(spells.map((entry) => entry.data.knowledgeGrade).filter(Boolean))].sort((a,b) => String(a).localeCompare(String(b),'it'));
---
<StarlightPage frontmatter={{ title: 'Manuale degli Incantesimi', description: 'Consulta e filtra gli Incantesimi.' }}>
  <SearchMetadata type="Catalogo" macroarea="Manuali" aliases={['incantesimi', 'manuale incantesimi', 'magie']} />

  <FelixCatalog searchLabel="Cerca nel Manuale" count={spells.length} countLabel="Incantesimi">
    <label class="felix-filter-control" slot="filters">
      <span>Famiglia</span>
      <select data-filter="family" data-filter-label="Famiglia"><option value="">Tutte</option>{families.map((value) => <option>{value}</option>)}</select>
    </label>
    <label class="felix-filter-control" slot="filters">
      <span>Tipo</span>
      <select data-filter="type" data-filter-label="Tipo"><option value="">Tutti</option>{types.map((value) => <option>{value}</option>)}</select>
    </label>
    <label class="felix-filter-control" slot="filters">
      <span>Parametro</span>
      <select data-filter="parameter" data-filter-label="Parametro"><option value="">Tutti</option>{parameters.map((value) => <option>{value}</option>)}</select>
    </label>
    <label class="felix-filter-control" slot="filters">
      <span>Grado di Conoscenza</span>
      <select data-filter="knowledgeGrade" data-param="grade" data-filter-label="Conoscenza"><option value="">Tutti</option>{grades.map((value) => <option>{value}</option>)}</select>
    </label>
    <label class="felix-filter-control" slot="filters">
      <span>Anno scolastico</span>
      <select data-filter="schoolYear" data-param="year" data-filter-label="Anno"><option value="">Tutti</option><option>V</option><option>VI</option><option>VII</option></select>
    </label>

    {spells.map((entry) => (
      <article
        class="felix-creature-row"
        data-card
        data-name={entry.data.name.toLowerCase()}
        data-description={entry.data.description.toLowerCase()}
        data-aliases={entry.data.searchAliases.join(' ').toLowerCase()}
        data-family={entry.data.family}
        data-type={entry.data.type}
        data-parameter={entry.data.parameter}
        data-knowledge-grade={entry.data.knowledgeGrade ?? ''}
        data-school-year={entry.data.schoolYear ?? ''}
      >
        <div>
          <h2><a href={routeForStructured('spells', entry.data.slug)}>{entry.data.name}</a></h2>
          <FelixBadges items={[entry.data.family, entry.data.knowledgeGrade ?? '', entry.data.schoolYear ? `Anno ${entry.data.schoolYear}` : '', entry.data.type]} />
          <p>{entry.data.description}</p>
          <p class="felix-note-small"><strong>Parametro:</strong> {entry.data.parameter} · <strong>Forza:</strong> {entry.data.force ?? '—'} · <strong>Fatica:</strong> {entry.data.fatigue ?? '—'}</p>
        </div>
      </article>
    ))}
  </FelixCatalog>
</StarlightPage>
