---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import AnchorHeading from '@astrojs/starlight/components/AnchorHeading.astro';
import { getCollection, render } from 'astro:content';
import FelixBadges from '../../../components/FelixBadges.astro';
import RelationList from '../../../components/RelationList.astro';
import SearchMetadata from '../../../components/search/SearchMetadata.astro';
import { buildBacklinkIndex } from '../../../lib/backlinks';
import { buildFelixIndex } from '../../../lib/content-index';

export async function getStaticPaths() {
  return (await getCollection('spells'))
    .filter((entry) => entry.data.status === 'published')
    .map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const index = await buildFelixIndex();
const backlinks = await buildBacklinkIndex();
const counteracts = entry.data.counteractsSpells.map((id) => index.get(id)).filter(Boolean);
const counteractedBy = (backlinks.get(entry.id) ?? [])
  .filter((item) => item.relation === 'counteractsSpell')
  .map((item) => index.get(item.sourceId))
  .filter(Boolean);
const related = entry.data.relatedFelixIds.map((id) => index.get(id)).filter(Boolean);
const pageHeadings = [...headings, { depth: 2, slug: 'valori', text: 'Valori' }];
---
<StarlightPage frontmatter={{ title: entry.data.name, description: entry.data.description }} headings={pageHeadings}>
  <SearchMetadata
    type="Incantesimo"
    macroarea="Manuali"
    aliases={entry.data.searchAliases}
    filters={{
      spell_family: entry.data.family,
      spell_type: entry.data.type,
      parameter: entry.data.parameter,
      knowledge_grade: entry.data.knowledgeGrade,
      school_year: entry.data.schoolYear,
    }}
  />

  <article class="felix-entry" data-pagefind-body>
    <div class="felix-entry-header">
      <div>
        <p class="felix-kicker">Manuali › Manuale degli Incantesimi › {entry.data.family}</p>
        <p class="felix-lead">{entry.data.description}</p>
        <FelixBadges items={[
          entry.data.family,
          entry.data.knowledgeGrade ?? '',
          entry.data.schoolYear ? `${entry.data.schoolYear} Anno` : '',
          entry.data.type,
        ]} />
      </div>
      {entry.data.image && <img class="felix-entry-image" src={entry.data.image} alt={`Illustrazione: ${entry.data.name}`} />}
    </div>

    <Content />

    <section>
      <AnchorHeading level="2" id="valori">Valori</AnchorHeading>
      <table class="felix-values">
        <thead>
          <tr><th>Tipo</th><th>Parametro</th><th>Forza</th><th>Fatica</th><th>Bersaglio</th><th>Gittata</th></tr>
        </thead>
        <tbody>
          <tr>
            <td>{entry.data.type}</td>
            <td>{entry.data.parameter}</td>
            <td>{entry.data.force ?? '—'}</td>
            <td>{entry.data.fatigue ?? '—'}</td>
            <td>{entry.data.target ?? '—'}</td>
            <td>{entry.data.range ?? '—'}</td>
          </tr>
        </tbody>
      </table>
    </section>

    <RelationList title="Annulla" items={counteracts} />
    <RelationList title="Può essere annullato da" items={counteractedBy} />
    <RelationList title="Regole e contenuti collegati" items={related} />
  </article>
</StarlightPage>
