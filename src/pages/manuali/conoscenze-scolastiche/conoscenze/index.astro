---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';
import FelixCatalog from '../../../../components/FelixCatalog.astro';
import FelixBadges from '../../../../components/FelixBadges.astro';
import SearchMetadata from '../../../../components/search/SearchMetadata.astro';
import { routeForStructured } from '../../../../config/routes';

const entries=(await getCollection('schoolKnowledges'))
  .filter((entry)=>entry.data.status==='published')
  .sort((a,b)=>a.data.subject.localeCompare(b.data.subject,'it') || a.data.schoolYear.localeCompare(b.data.schoolYear,'it'));
---
<StarlightPage frontmatter={{title:'Altre Conoscenze Scolastiche',description:'Consulta le 15 Conoscenze di Antiche Rune, Aritmanzia, Astronomia, Babbanologia e Storia della Magia.'}}>
  <SearchMetadata type="Catalogo" macroarea="Manuali" aliases={['altre conoscenze scolastiche','antiche rune','aritmanzia','astronomia','babbanologia','storia della magia']} />

  <FelixCatalog searchLabel="Cerca una Conoscenza" searchPlaceholder="Nome, materia, anno o effetto..." count={entries.length} countLabel="Conoscenze">
    <label class="felix-filter-control" slot="filters">
      <span>Materia</span>
      <select data-filter="subject" data-filter-label="Materia">
        <option value="">Tutte</option>
        {['Antiche Rune','Aritmanzia','Astronomia','Babbanologia','Storia della Magia'].map((value)=><option>{value}</option>)}
      </select>
    </label>
    <label class="felix-filter-control" slot="filters">
      <span>Anno</span>
      <select data-filter="schoolYear" data-filter-label="Anno">
        <option value="">Tutti</option>
        <option>V</option>
        <option>VI</option>
        <option>VII</option>
      </select>
    </label>

    {entries.map((entry)=>(
      <article
        class="felix-creature-row"
        data-card
        data-haystack={`${entry.data.name} ${entry.data.description} ${entry.data.subject} ${entry.data.schoolYear} ${entry.data.searchAliases.join(' ')}`.toLowerCase()}
        data-subject={entry.data.subject}
        data-school-year={entry.data.schoolYear}
      >
        <div>
          <h2><a href={routeForStructured('schoolKnowledges',entry.data.slug)}>{entry.data.name}</a></h2>
          <FelixBadges items={[entry.data.subject,`Anno ${entry.data.schoolYear}`]} />
          <p>{entry.data.description}</p>
        </div>
      </article>
    ))}
  </FelixCatalog>
</StarlightPage>
