---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection, render } from 'astro:content';
import FelixEntityHeader from '../../../../components/FelixEntityHeader.astro';
import SearchMetadata from '../../../../components/search/SearchMetadata.astro';

export async function getStaticPaths(){
  return (await getCollection('schoolKnowledges'))
    .filter((entry)=>entry.data.status==='published')
    .map((entry)=>({params:{slug:entry.data.slug},props:{entry}}));
}
const {entry}=Astro.props;
const {Content,headings}=await render(entry);
---
<StarlightPage frontmatter={{title:entry.data.name,description:entry.data.description}} headings={headings}>
  <SearchMetadata
    type="Conoscenza Scolastica"
    macroarea="Manuali"
    aliases={entry.data.searchAliases}
    filters={{subject:entry.data.subject,school_year:entry.data.schoolYear}}
  />
  <article class="felix-entry" data-pagefind-body>
    <FelixEntityHeader
      description={entry.data.description}
      image={entry.data.image}
      imageAlt={`Conoscenza Scolastica: ${entry.data.name}`}
      badges={['Conoscenza Scolastica',entry.data.subject,`Anno ${entry.data.schoolYear}`]}
      facts={[
        {label:'Materia',value:entry.data.subject},
        {label:'Anno',value:entry.data.schoolYear},
      ]}
    />
    <Content />
  </article>
</StarlightPage>
