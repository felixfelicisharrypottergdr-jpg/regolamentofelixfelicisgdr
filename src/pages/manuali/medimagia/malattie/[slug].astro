---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import AnchorHeading from '@astrojs/starlight/components/AnchorHeading.astro';
import { getCollection, render } from 'astro:content';
import { buildBacklinkIndex } from '../../../../lib/backlinks';
import { buildFelixIndex } from '../../../../lib/content-index';
import SearchMetadata from '../../../../components/search/SearchMetadata.astro';
import FelixEntityHeader from '../../../../components/FelixEntityHeader.astro';
import FelixDataTable from '../../../../components/FelixDataTable.astro';

export async function getStaticPaths() {
  return (await getCollection('diseases')).filter((entry) => entry.data.status === 'published').map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const backlinks = await buildBacklinkIndex();
const index = await buildFelixIndex();
const pageHeadings = [...headings, { depth: 2, slug: 'sintomi', text: 'Sintomi' }];
const entryBacklinks = backlinks.get(entry.id) ?? [];
const causes = entryBacklinks
  .filter((item) => item.relation === 'causesDisease')
  .map((item) => index.get(item.sourceId))
  .filter(Boolean);
const preventionPotions = entryBacklinks
  .filter((item) => item.relation === 'preventsDisease')
  .map((item) => index.get(item.sourceId))
  .filter(Boolean);
const symptomRows = entry.data.symptomBands.map((band) => ({
  range: band.range,
  symptoms: band.symptoms.join(', '),
}));
---
<StarlightPage frontmatter={{ title: entry.data.name, description: entry.data.description }} headings={pageHeadings}>
  <SearchMetadata type="Malattia Magica" macroarea="Manuali" aliases={entry.data.searchAliases} />
  <article class="felix-entry" data-pagefind-body>
    <FelixEntityHeader
      description={entry.data.description}
      imageAlt={`Malattia: ${entry.data.name}`}
      facts={[
        { label: 'Malus', value: entry.data.malus ?? '—' },
        { label: 'PG a rischio', value: entry.data.atRisk ?? '—' },
        { label: 'Prevenzione', value: entry.data.prevention.length ? entry.data.prevention.join(', ') : '—' },
      ]}
    />
    <Content />

    <AnchorHeading level="2" id="sintomi">Sintomi</AnchorHeading>
    <FelixDataTable
      ariaLabel="Sintomi per Salute persa"
      columns={[
        { key: 'range', label: 'Salute persa' },
        { key: 'symptoms', label: 'Sintomi' },
      ]}
      rows={symptomRows}
    />
  </article>
</StarlightPage>
