---
interface Props {
  type: string;
  macroarea?: string;
  aliases?: string[];
  filters?: Record<string, string | string[] | boolean | undefined>;
}

const { type, macroarea, aliases = [], filters = {} } = Astro.props;
// Cataloghi condivisi: la reperibilità non sostituisce i requisiti di utilizzo.
// Missioni, Razze e Maestrie forniscono esplicitamente la propria applicabilità.
const searchFilters = { applicability: ['PG Studente', 'PG Adulto'], ...filters };
const normalizedFilters = Object.entries(searchFilters).flatMap(([key, value]) => {
  if (value === undefined || value === false || value === '') return [];
  const values = Array.isArray(value) ? value : [value === true ? 'Sì' : String(value)];
  return values.map((item) => ({ key, value: String(item) }));
});
---
<div class="felix-pagefind-meta" aria-hidden="true" data-pagefind-ignore>
  <span data-pagefind-meta="content_type">{type}</span>
  <span data-pagefind-filter={`content_type:${type}`}></span>
  {macroarea && <span data-pagefind-meta="macroarea">{macroarea}</span>}
  {macroarea && <span data-pagefind-filter={`macroarea:${macroarea}`}></span>}
  {aliases.length > 0 && <span data-pagefind-meta="aliases">{aliases.join(' · ')}</span>}
  {normalizedFilters.map(({ key, value }) => <span data-pagefind-filter={`${key}:${value}`}></span>)}
</div>
