---
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import FelixHome from '../FelixHome.astro';
import FelixLandingDirectory from '../FelixLandingDirectory.astro';

const route = Astro.locals.starlightRoute;
const routeId = route.id || '';
const isHome = routeId === '' || routeId === 'index';
const data = route.entry.data as Record<string, any>;
const contentType = data.contentType ?? 'rule';
const quickLinks = Array.isArray(data.quickLinks) ? data.quickLinks : [];
---
{isHome ? (
  <div class="sl-markdown-content felix-home-content">
    <FelixHome />
  </div>
) : (
  <div class:list={['felix-content-wrap', `is-${contentType}`]}>
    {contentType === 'landing' && <FelixLandingDirectory links={quickLinks} />}
    <Default>
      <slot />
    </Default>
  </div>
)}
