---
const configuredBase = import.meta.env.BASE_URL || '/';
const base = configuredBase.endsWith('/') ? configuredBase : `${configuredBase}/`;
---
<button class="felix-search-trigger" type="button" data-felix-search-open aria-haspopup="dialog">
  <span>⌕ Cerca nel Regolamento…</span>
  <kbd>Ctrl K</kbd>
</button>

<dialog class="felix-search-dialog" data-felix-search-dialog>
  <div class="felix-search-shell">
    <div class="felix-search-head">
      <label class="felix-search-box">
        <span class="sr-only">Cerca in FELIX FELICIS</span>
        <input type="search" placeholder="Regola, Razza, Creatura, Pozione, Oggetto…" autocomplete="off" data-felix-search-input />
      </label>
      <button type="button" class="felix-search-close" data-felix-search-close aria-label="Chiudi ricerca">×</button>
    </div>

    <div class="felix-search-types" aria-label="Filtra i risultati per tipo">
      <button type="button" class="is-active" data-search-type="">Tutti</button>
      <button type="button" data-search-type="Regola">Regole</button>
      <button type="button" data-search-type="Incantesimo">Incantesimi</button>
      <button type="button" data-search-type="Pozione">Pozioni</button>
      <button type="button" data-search-type="Creatura">Creature</button>
      <button type="button" data-search-type="Pianta">Piante</button>
      <button type="button" data-search-type="Ingrediente">Ingredienti</button>
      <button type="button" data-search-type="Malattia Magica">Malattie</button>
      <button type="button" data-search-type="Maestria">Maestrie</button>
      <button type="button" data-search-type="Conoscenza Scolastica">Conoscenze</button>
      <button type="button" data-search-type="Tecnica Divinatoria">Divinazione</button>
      <button type="button" data-search-type="Missione FantaHogwarts">FantaHogwarts</button>
      <button type="button" data-search-type="Missione FantaWiz">FantaWiz</button>
      <button type="button" data-search-type="Oggetto">Oggetti</button>
      <button type="button" data-search-type="Razza">Razze</button>
      <button type="button" data-search-type="Documento normativo">Documenti</button>
      <button type="button" data-search-type="Articolo">Articoli</button>
    </div>

    <p class="felix-search-hint" data-search-hint>
      Puoi cercare anche con termini non regolamentari: gli alias editoriali aiutano a raggiungere la voce corretta.
    </p>
    <p class="felix-search-status" role="status" aria-live="polite" data-search-status></p>
    <div class="felix-search-results" data-search-results></div>
    <button type="button" class="felix-search-more" data-search-more hidden>Mostra altri risultati</button>
  </div>
</dialog>

<script is:inline define:vars={{ base }}>
  (() => {
    const dialog = document.querySelector('[data-felix-search-dialog]');
    const openButton = document.querySelector('[data-felix-search-open]');
    const closeButton = dialog?.querySelector('[data-felix-search-close]');
    const input = dialog?.querySelector('[data-felix-search-input]');
    const status = dialog?.querySelector('[data-search-status]');
    const results = dialog?.querySelector('[data-search-results]');
    const moreButton = dialog?.querySelector('[data-search-more]');
    const hint = dialog?.querySelector('[data-search-hint]');
    const typeButtons = [...(dialog?.querySelectorAll('[data-search-type]') || [])];
    const applicabilityButtons = [...(dialog?.querySelectorAll('[data-search-applicability]') || [])];
    let activeType = '';
    let activeApplicability = '';
    let pagefindPromise;
    let searchTimer;
    let lastSearchResults = [];
    let visibleLimit = 24;

    const loadPagefind = async () => {
      if (!pagefindPromise) {
        pagefindPromise = import(`${base}pagefind/pagefind.js`).then(async (pagefind) => {
          await pagefind.options({
            ranking: {
              metaWeights: {
                title: 8,
                aliases: 6,
                description: 3,
                content_type: 0,
                macroarea: 0,
              },
            },
          });
          await pagefind.init();
          return pagefind;
        });
      }
      return pagefindPromise;
    };

    const setStatus = (message = '') => {
      if (status) status.textContent = message;
    };

    const renderResult = (data) => {
      const article = document.createElement('article');
      article.className = 'felix-search-result';

      const header = document.createElement('div');
      header.className = 'felix-search-result-head';
      const type = document.createElement('span');
      type.className = 'felix-search-result-type';
      type.textContent = data.meta?.content_type || 'Regolamento';
      const macroarea = document.createElement('span');
      macroarea.className = 'felix-search-result-path';
      macroarea.textContent = data.meta?.macroarea || '';
      header.append(type, macroarea);

      const title = document.createElement('h3');
      const link = document.createElement('a');
      link.href = data.url;
      link.textContent = data.meta?.title || data.url;
      title.append(link);

      const excerpt = document.createElement('p');
      excerpt.className = 'felix-search-result-excerpt';
      excerpt.innerHTML = data.excerpt || data.meta?.description || '';

      article.append(header, title, excerpt);
      return article;
    };

    const renderSearchResults = async () => {
      const slice = lastSearchResults.slice(0, visibleLimit);
      const data = await Promise.all(slice.map((item) => item.data()));
      results?.replaceChildren(...data.map(renderResult));
      if (moreButton instanceof HTMLButtonElement) {
        moreButton.hidden = visibleLimit >= lastSearchResults.length;
        moreButton.textContent = moreButton.hidden
          ? 'Mostra altri risultati'
          : `Mostra altri risultati (${Math.min(24, lastSearchResults.length - visibleLimit)})`;
      }
    };

    const runSearch = async () => {
      const query = input?.value.trim() || '';
      if (!query) {
        lastSearchResults = [];
        visibleLimit = 24;
        results?.replaceChildren();
        if (moreButton instanceof HTMLButtonElement) moreButton.hidden = true;
        setStatus('');
        if (hint) hint.hidden = false;
        return;
      }
      if (hint) hint.hidden = true;
      setStatus('Ricerca…');
      try {
        const pagefind = await loadPagefind();
        const filters = {};
        if (activeType) filters.content_type = activeType;
        if (activeApplicability) filters.applicability = activeApplicability;
        const options = Object.keys(filters).length ? { filters } : {};
        const search = await pagefind.search(query, options);
        lastSearchResults = search.results;
        visibleLimit = 24;
        await renderSearchResults();
        setStatus(`${search.results.length} ${search.results.length === 1 ? 'risultato' : 'risultati'} per “${query}”`);
      } catch (error) {
        lastSearchResults = [];
        results?.replaceChildren();
        if (moreButton instanceof HTMLButtonElement) moreButton.hidden = true;
        setStatus('L’indice di ricerca viene generato durante la build del sito. In modalità di sviluppo può non essere ancora disponibile.');
      }
    };

    const queueSearch = () => {
      clearTimeout(searchTimer);
      searchTimer = setTimeout(runSearch, 120);
    };

    const open = () => {
      if (!dialog?.open) dialog?.showModal();
      requestAnimationFrame(() => input?.focus());
      loadPagefind().catch(() => {});
    };

    openButton?.addEventListener('click', open);
    closeButton?.addEventListener('click', () => dialog?.close());
    dialog?.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    input?.addEventListener('input', queueSearch);
    moreButton?.addEventListener('click', async () => {
      visibleLimit += 24;
      await renderSearchResults();
    });

    typeButtons.forEach((button) => button.addEventListener('click', () => {
      activeType = button.dataset.searchType || '';
      typeButtons.forEach((item) => item.classList.toggle('is-active', item === button));
      runSearch();
    }));

    applicabilityButtons.forEach((button) => button.addEventListener('click', () => {
      activeApplicability = button.dataset.searchApplicability || '';
      applicabilityButtons.forEach((item) => item.classList.toggle('is-active', item === button));
      runSearch();
    }));

    document.addEventListener('keydown', (event) => {
      if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        open();
      }
      if (event.key === '/' && !dialog?.open && !/INPUT|TEXTAREA|SELECT/.test(document.activeElement?.tagName || '')) {
        event.preventDefault();
        open();
      }
    });
  })();
</script>
