---
const route = Astro.locals.starlightRoute;
const data = route.entry.data as Record<string, any>;
const aliases = Array.isArray(data.searchAliases) ? data.searchAliases : [];
const applicability = Array.isArray(data.applicability) ? data.applicability : [];
const title = data.title ?? 'Regolamento';
const isHome = route.id === '' || route.id === 'index';

const typeMap: Record<string, string> = {
  landing: 'Pagina di ingresso',
  rule: 'Regola',
  free: 'Pagina',
};
const type = data.contentType ? (typeMap[data.contentType] ?? 'Pagina') : undefined;

const firstSegment = route.id.split('/').filter(Boolean)[0] ?? '';
const macroareaMap: Record<string, string> = {
  'inizia-da-qui': 'Inizia da qui',
  'il-personaggio': 'Il Personaggio',
  giocare: 'Giocare',
  'conoscenze-e-sapienze': 'Conoscenze e Sapienze',
  manuali: 'Manuali',
  'mondo-magico': 'Mondo Magico',
};
const macroarea = isHome ? 'Inizia da qui' : (macroareaMap[firstSegment] ?? 'Regolamento');

const applicabilityLabels = applicability.length === 2
  ? ['Tutti i PG']
  : applicability.map((item: string) => item === 'student' ? 'PG Studente' : 'PG Adulto');

const currentPath = Astro.url.pathname.replace(/\/+$/, '/') || '/';
const structuredRouteBases = [
  '/conoscenze-e-sapienze/maestrie/',
  '/il-personaggio/pg-adulto/modalita-di-gioco/fantawiz/missioni/',
  '/il-personaggio/pg-studente/modalita-di-gioco/fantahogwarts/missioni/',
  '/il-personaggio/razze/',
  '/manuali/conoscenze-scolastiche/conoscenze/',
  '/manuali/divinazione/tecniche/',
  '/manuali/erbologia/erbario/',
  '/manuali/incantesimi/',
  '/manuali/ingredienti/',
  '/manuali/magizoologia/bestiario/',
  '/manuali/medimagia/malattie/',
  '/manuali/pozionistica/pozionario/',
  '/mondo-magico/commercio/oggetti/',
  '/mondo-magico/leggi/',
];
const isStructuredRoute = structuredRouteBases.some((prefix) => currentPath.includes(prefix));
const pagefindType = isStructuredRoute ? undefined : type;
const normalize = (href = '') => {
  try { return new URL(href, Astro.url.origin).pathname.replace(/\/+$/, '/') || '/'; }
  catch { return href.replace(/\/+$/, '/') || '/'; }
};

const matchingHref = (entry: any) => {
  if (entry.type !== 'link') return '';
  const href = normalize(entry.href);
  if (currentPath === href) return href;
  if (href !== '/' && currentPath.startsWith(href)) return href;
  return '';
};

type TrailCandidate = { trail: { label: string; href?: string }[]; score: number };

const collectTrails = (
  entries: any[],
  parents: { label: string; href?: string }[] = [],
  out: TrailCandidate[] = [],
) => {
  for (const entry of entries) {
    if (entry.type === 'link') {
      const href = matchingHref(entry);
      if (href) out.push({ trail: [...parents, { label: entry.label, href: entry.href }], score: href.length });
    } else if (entry.type === 'group') {
      collectTrails(entry.entries ?? [], [...parents, { label: entry.label }], out);
    }
  }
  return out;
};

const candidates = collectTrails(route.sidebar);
const best = candidates.sort((a, b) => b.score - a.score)[0];
let trail = best?.trail ?? [];
if (!isHome && (trail.length === 0 || trail[trail.length - 1]?.label !== title)) {
  trail = [...trail, { label: title }];
}
---
{!isHome && (
  <>
    {trail.length > 1 && (
      <nav class="felix-breadcrumbs" aria-label="Percorso">
        {trail.map((item, index) => (
          <>
            {index > 0 && <span class="felix-breadcrumb-sep" aria-hidden="true">›</span>}
            {item.href && index < trail.length - 1
              ? <a href={item.href}>{item.label}</a>
              : <span aria-current={index === trail.length - 1 ? 'page' : undefined}>{item.label}</span>}
          </>
        ))}
      </nav>
    )}
    <h1 id="_top" class="felix-page-title">{title}</h1>
    {applicabilityLabels.length > 0 && (
      <div class="felix-applicability" aria-label="Applicabilità della regola">
        {applicabilityLabels.map((label: string) => <span class="felix-badge">{label}</span>)}
      </div>
    )}
  </>
)}
{pagefindType && (
  <div class="felix-pagefind-meta" aria-hidden="true" data-pagefind-ignore>
    <span data-pagefind-meta="content_type">{pagefindType}</span>
    <span data-pagefind-filter={`content_type:${pagefindType}`}></span>
    <span data-pagefind-meta="macroarea">{macroarea}</span>
    <span data-pagefind-filter={`macroarea:${macroarea}`}></span>
    {aliases.length > 0 && <span data-pagefind-meta="aliases">{aliases.join(' · ')}</span>}
  </div>
)}

{applicability.length > 0 && (
  <div class="felix-pagefind-meta" aria-hidden="true" data-pagefind-ignore>
    {applicability.map((item: string) => (
      <span data-pagefind-filter={`applicability:${item === 'student' ? 'PG Studente' : 'PG Adulto'}`}></span>
    ))}
  </div>
)}
