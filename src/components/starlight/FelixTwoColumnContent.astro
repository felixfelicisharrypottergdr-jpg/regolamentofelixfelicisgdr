---
const toc = Astro.locals.starlightRoute.toc;
const hasUsefulToc = Boolean(toc && (toc.items?.length ?? 0) > 1);
---
<div class:list={['felix-two-column', { 'has-toc': hasUsefulToc, 'no-toc': !hasUsefulToc }]}>
  {hasUsefulToc && (
    <aside class="felix-right-sidebar print:hidden">
      <slot name="right-sidebar" />
    </aside>
  )}
  <div class="main-pane"><slot /></div>
</div>
