---
const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
const href = (path = '') => `${base}${path}`;
---
<section class="felix-home-splash">
  <div class="felix-home-splash-copy">
    <p class="felix-home-eyebrow">Il Regolamento di FELIX FELICIS</p>
    <h1>Benvenuto nel Regolamento</h1>
    <p class="felix-home-tagline">Tutto ciò che ti serve per vivere la tua storia nel mondo magico.</p>

    <button class="felix-home-search" type="button" data-home-search-open>
      <span class="felix-home-search-icon" aria-hidden="true">⌕</span>
      <span>Cerca una regola, una Creatura, una Pozione…</span>
      <span class="felix-home-search-arrow" aria-hidden="true">→</span>
    </button>

    <div class="felix-home-examples" aria-label="Esempi di ricerca">
      <span>Ad esempio:</span>
      <button type="button" data-home-search-query="Fiducia">Fiducia</button>
      <button type="button" data-home-search-query="recuperare Salute">recuperare Salute</button>
      <button type="button" data-home-search-query="Pozioni illegali">Pozioni illegali</button>
      <button type="button" data-home-search-query="Nundu">Nundu</button>
    </div>
  </div>

  <div class="felix-home-sigil" aria-hidden="true">
    <svg viewBox="0 0 180 180">
      <circle cx="90" cy="90" r="62" />
      <circle cx="90" cy="90" r="44" />
      <path d="M90 23l10 28 29 2-23 18 7 29-23-16-23 16 7-29-23-18 29-2 10-28Z" />
      <path d="M90 45v90M45 90h90" />
      <circle cx="90" cy="90" r="7" />
    </svg>
  </div>
</section>

<section class="felix-home-areas" aria-label="Aree del Regolamento">
  <a href={href('')} class="felix-area-card">
    <span class="felix-area-icon">✦</span>
    <strong>Inizia da qui</strong>
    <span>Scopri come funziona il gioco e come muovere i primi passi.</span>
    <i>→</i>
  </a>
  <a href={href('il-personaggio/')} class="felix-area-card">
    <span class="felix-area-icon">♙</span>
    <strong>Il Personaggio</strong>
    <span>Crea, sviluppa e personalizza il tuo PG.</span>
    <i>→</i>
  </a>
  <a href={href('giocare/')} class="felix-area-card">
    <span class="felix-area-icon">⚔</span>
    <strong>Giocare</strong>
    <span>Regole di gioco, Azioni, Scontri, Role e molto altro.</span>
    <i>→</i>
  </a>
  <a href={href('conoscenze-e-sapienze/')} class="felix-area-card">
    <span class="felix-area-icon">✣</span>
    <strong>Conoscenze e Sapienze</strong>
    <span>Come si acquisiscono, si usano e si migliorano.</span>
    <i>→</i>
  </a>
  <a href={href('manuali/')} class="felix-area-card">
    <span class="felix-area-icon">▤</span>
    <strong>Manuali</strong>
    <span>Incantesimi, Bestiario, Erbario, Pozionario e discipline.</span>
    <i>→</i>
  </a>
  <a href={href('mondo-magico/')} class="felix-area-card">
    <span class="felix-area-icon">⌘</span>
    <strong>Mondo Magico</strong>
    <span>Leggi, istituzioni, Trasporti, Quidditch e vita magica.</span>
    <i>→</i>
  </a>
</section>

<div class="felix-home-lower">
  <section class="felix-home-tasks">
    <div class="felix-home-section-head">
      <div>
        <h2>Cosa devi fare?</h2>
        <p>Se non sai da dove iniziare, scegli quello che vuoi fare.</p>
      </div>
      <a href={href('giocare/')}>Vedi tutti gli argomenti →</a>
    </div>

    <div class="felix-task-grid">
      <a href={href('giocare/guida-agli-scontri/')}><span>⚔</span>Combattere</a>
      <a href={href('manuali/pozionistica/')}><span>⚗</span>Preparare una Pozione</a>
      <a href={href('giocare/ricerche-casuali/ricerca-creature/')}><span>♞</span>Cercare una Creatura</a>
      <a href={href('manuali/erbologia/')}><span>❧</span>Coltivare una Pianta</a>
      <a href={href('mondo-magico/trasporti/')}><span>✥</span>Viaggiare</a>
      <a href={href('mondo-magico/commercio/')}><span>◉</span>Comprare / Vendere</a>
      <a href={href('conoscenze-e-sapienze/')}><span>▥</span>Migliorare il PG</a>
      <a href={href('giocare/azioni-illegali/')}><span>⚠</span>Compiere un'Azione illegale</a>
    </div>
  </section>

  <aside class="felix-home-quick">
    <p class="felix-home-eyebrow">Accessi rapidi</p>
    <h2>Le pagine più consultate</h2>
    <div class="felix-home-quick-grid">
      <a href={href('il-personaggio/parametri/')}>Parametri <span>→</span></a>
      <a href={href('manuali/magizoologia/bestiario/')}>Bestiario <span>→</span></a>
      <a href={href('giocare/guida-agli-scontri/')}>Scontri <span>→</span></a>
      <a href={href('manuali/erbologia/erbario/')}>Erbario <span>→</span></a>
      <a href={href('manuali/pozionistica/pozionario/')}>Pozionario <span>→</span></a>
      <a href={href('manuali/incantesimi/')}>Incantesimi <span>→</span></a>
      <a href={href('mondo-magico/leggi/')}>Leggi Magiche <span>→</span></a>
      <a href={href('mondo-magico/trasporti/')}>Trasporti <span>→</span></a>
    </div>
  </aside>
</div>

<p class="felix-home-migration"><strong>Migrazione in corso.</strong> Il sito sta sostituendo progressivamente il Regolamento attuale; quando una pagina è ancora un estratto, la condizione è indicata direttamente nel contenuto.</p>

<script>
  const openGlobalSearch = (query = '') => {
    const trigger = document.querySelector('[data-felix-search-open]');
    trigger?.dispatchEvent(new MouseEvent('click', { bubbles: true }));
    if (query) {
      window.setTimeout(() => {
        const input = document.querySelector('[data-felix-search-input]');
        if (input instanceof HTMLInputElement) {
          input.value = query;
          input.dispatchEvent(new Event('input', { bubbles: true }));
        }
      }, 80);
    }
  };

  document.querySelector('[data-home-search-open]')?.addEventListener('click', () => openGlobalSearch());
  document.querySelectorAll('[data-home-search-query]').forEach((button) => {
    button.addEventListener('click', () => openGlobalSearch(button.getAttribute('data-home-search-query') || ''));
  });
</script>
