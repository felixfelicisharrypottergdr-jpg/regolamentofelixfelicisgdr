---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import AnchorHeading from '@astrojs/starlight/components/AnchorHeading.astro';
import { getCollection, render } from 'astro:content';
import FelixBadges from '../../../components/FelixBadges.astro';
import RelationList from '../../../components/RelationList.astro';
import SearchMetadata from '../../../components/search/SearchMetadata.astro';
import { buildFelixIndex } from '../../../lib/content-index';

export async function getStaticPaths() {
  return (await getCollection('races')).filter((entry) => entry.data.status === 'published').map((entry) => ({
    params: { slug: entry.data.slug }, props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const index = await buildFelixIndex();
const related = entry.data.relatedFelixIds.map((id) => index.get(id)).filter(Boolean);
const pageHeadings = [...headings, { depth: 2, slug: 'posti-disponibili', text: 'Posti disponibili' }];
---
<StarlightPage frontmatter={{ title: entry.data.name, description: entry.data.description }} headings={pageHeadings}>
  <SearchMetadata type="Razza" macroarea="Il Personaggio" aliases={entry.data.searchAliases} filters={{ applicability: ['PG Studente', 'PG Adulto'] }} />
  <article class="felix-entry" data-pagefind-body>
    <div class="felix-entry-header">
      <div>
        <p class="felix-kicker">Il Personaggio › Razze › Elenco delle Razze</p>
        <p class="felix-lead">{entry.data.description}</p>
        <FelixBadges items={['PG Studente', 'PG Adulto', entry.data.availablePlaces ? `Posti disponibili: ${entry.data.availablePlaces}` : '']} />
      </div>
      {entry.data.image && <img class="felix-entry-image" src={entry.data.image} alt={`Illustrazione: ${entry.data.name}`} />}
    </div>

    <Content />

    <section>
      <AnchorHeading level="2" id="posti-disponibili">Posti disponibili</AnchorHeading>
      <p>{entry.data.availablePlaces ? `${entry.data.availablePlaces} secondo la fonte migrata nel prototipo.` : 'Dato non ancora inserito.'}</p>
      <p class="felix-note-small">Il sito resta consultativo: questo dato è aggiornabile dallo Staff nel CMS e non viene calcolato automaticamente in base ai PG esistenti.</p>
    </section>

    <RelationList title="Percorsi collegati" items={related} />
  </article>
</StarlightPage>
