---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';
import FelixBadges from '../../../components/FelixBadges.astro';
import SearchMetadata from '../../../components/search/SearchMetadata.astro';
import { routeForStructured } from '../../../config/routes';

const ingredients = (await getCollection('ingredients'))
  .filter((entry) => entry.data.status === 'published')
  .sort((a, b) => a.data.name.localeCompare(b.data.name, 'it'));
---
<StarlightPage frontmatter={{ title: 'Ingredienti', description: 'Consulta le schede Ingredienti migrate nel prototipo.' }}>
  <SearchMetadata type="Catalogo" macroarea="Manuali" aliases={['ingredienti', 'glossario ingredienti']} />
  <section>
    <p class="felix-kicker">Manuali › Ingredienti</p>
    <p class="felix-lead">Glossario degli Ingredienti — campione tecnico del prototipo.</p>
    <div class="felix-catalog-toolbar">
      <label>Cerca negli Ingredienti <input type="search" data-ingredient-query placeholder="Nome, provenienza o alias..." /></label>
      <strong><span data-ingredient-count>{ingredients.length}</span> Ingredienti</strong>
    </div>
    <div data-ingredient-list data-pagefind-ignore>
      {ingredients.map((entry) => (
        <article class="felix-creature-row" data-ingredient-card data-haystack={`${entry.data.name} ${entry.data.description} ${entry.data.provenance} ${entry.data.searchAliases.join(' ')}`.toLowerCase()}>
          <h2><a href={routeForStructured('ingredients', entry.data.slug)}>{entry.data.name}</a></h2>
          <FelixBadges items={[entry.data.classification, entry.data.goodsClass, entry.data.legality, entry.data.exotic ? 'Esotico' : '']} />
          <p>{entry.data.description || entry.data.provenance}</p>
        </article>
      ))}
    </div>
  </section>
  <script>
    const input = document.querySelector('[data-ingredient-query]');
    const cards = [...document.querySelectorAll('[data-ingredient-card]')];
    const count = document.querySelector('[data-ingredient-count]');
    const apply = () => {
      const q = (input?.value || '').trim().toLowerCase();
      let visible = 0;
      cards.forEach((card) => { const show = !q || (card.dataset.haystack || '').includes(q); card.hidden = !show; if (show) visible += 1; });
      if (count) count.textContent = String(visible);
    };
    input?.addEventListener('input', apply);
  </script>
</StarlightPage>
